---
// Animated "error windows" block.
//
// A stage with an animated dithered-blob background and a stack of retro error
// windows. The windows bounce in when the block scrolls into view, can be
// dragged around by their title bar, and jump to the front when touched.
//
// Behaviour lives in ./errorWindows.ts; this file is markup + styling.
import { AlertTriangle } from "@lucide/astro";

interface Props {
  /** One message per window, in stacking order (bottom to top). */
  t: { windows: string[] };
  /**
   * Section heading, one line per rendered box. Only shown from `md` up, where
   * it lives inside the stage (on mobile the page renders it above the block).
   */
  title?: string[];
}

const { t, title = [] } = Astro.props;

// Fixed layout for each window: position + size (as % of the stage) and the
// stagger delay for its entrance. Paired with the messages from i18n.
// Mobile stacks them almost full-width; desktop tucks a smaller, tighter
// cascade into the right half so the heading can breathe on the left.
const LAYOUT = [
  { left: 3, top: 2.5, width: 65, delay: 0.05 },
  { left: 33, top: 24, width: 64, delay: 0.35 },
  { left: 6, top: 43, width: 66, delay: 0.65 },
  { left: 31, top: 65, width: 62, delay: 0.95 },
  { left: 15, top: 81, width: 64, delay: 1.25 },
];

const LAYOUT_MD = [
  { left: 40, top: 15, width: 28 },
  { left: 53, top: 29, width: 28 },
  { left: 66, top: 42.5, width: 28 },
  { left: 53, top: 55, width: 28 },
  { left: 40, top: 68, width: 28 },
];

const windows = LAYOUT.map((layout, i) => ({
  ...layout,
  md: LAYOUT_MD[i],
  message: t.windows[i],
}));
---

<div class="error-windows h-screen" data-error-windows>
  <div class="stage" data-stage>
    <canvas class="stage__blobs w-full" data-blob-canvas aria-hidden="true"></canvas>

    {
      title.length > 0 && (
        <h3 class="stage__title">
          {title.map((line) => (
            <span>{line}</span>
          ))}
        </h3>
      )
    }

    {
      windows.map((win, i) => (
        <div
          class="window"
          style={`--l:${win.left}%; --t:${win.top}%; --w:${win.width}%; --l-md:${win.md.left}%; --t-md:${win.md.top}%; --w-md:${win.md.width}%; z-index:${i + 1}; --appear-delay:${win.delay}s;`}
        >
          <div class="window__bar">
            <AlertTriangle class="window__icon" size={18} aria-hidden="true" />
            <div class="window__controls" aria-hidden="true">
              <span class="window__min">–</span>
              <span class="window__box" />
              <span class="window__close">×</span>
            </div>
          </div>
          <div class="window__body">
            <p>{win.message}</p>
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .error-windows {
    --ink: var(--color-primary, #00006c);
    --accent: var(--color-secondary, #00c800);
    width: 100%;
    margin: 0 auto;
    position: relative;
  }
  .error-windows::before {
    content: "";
    display: block;
    position: absolute;
    background: linear-gradient(180deg, #ffffff 0%, #ffffff00 100%);
    width: 100%;
    height: 100px;
    top: -1px;
    left: 0;
    z-index: 1;
  }
  .error-windows::after {
    content: "";
    display: block;
    position: absolute;
    background: linear-gradient(0deg, #ffffff 0%, #ffffff00 100%);
    width: 100%;
    height: 100px;
    bottom: -1px;
    left: 0;
    z-index: 1;
  }

  .stage {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    background: #fff;
    container-type: inline-size;
  }

  .stage__blobs {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }

  /* --- Windows ----------------------------------------------------------- */

  /* Título dentro del stage: solo desktop. En mobile lo renderiza la página
     arriba del bloque. Va después del canvas y sin z-index, así queda sobre el
     fondo dithered pero debajo de las ventanas (que sí lo tienen). */
  .stage__title {
    display: none;
  }

  .window {
    position: absolute;
    box-sizing: border-box;
    left: var(--l);
    top: var(--t);
    width: var(--w);
    background: #fff;
    border: 2px solid var(--ink);
    touch-action: none;
    /* El contenido de una ventana no afecta al layout del resto del stage:
       acotarlo evita que arrastrar una recalcule las otras cuatro. */
    contain: layout paint;
    /* Hidden until the block scrolls into view (see .is-visible below). */
    opacity: 0;
  }

  /* Solo mientras se arrastra: promueve la ventana a su propia capa en vez de
     dejarla permanentemente promovida (5 capas fijas encarecen el scroll). */
  .window.is-dragging {
    will-change: left, top;
  }

  .window__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: clamp(6px, 2cqw, 10px) clamp(10px, 3cqw, 16px);
    border-bottom: 2px solid var(--ink);
    cursor: move;
    user-select: none;
  }

  .window__icon {
    flex-shrink: 0;
    color: var(--accent);
  }

  .window__controls {
    display: flex;
    align-items: center;
    gap: clamp(8px, 2.4cqw, 14px);
    color: var(--ink);
    font-family: var(--font-roboto-mono, monospace);
  }

  .window__min,
  .window__close {
    font-size: clamp(14px, 3.6cqw, 18px);
    line-height: 1;
  }

  .window__box {
    width: 12px;
    height: 12px;
    border: 1.4px solid var(--ink);
    display: inline-block;
  }

  .window__body {
    padding:24px;
  }

  .window__body p {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-roboto-mono, monospace);
    font-size: clamp(14px, 4.2cqw, 19px);
    line-height: 1.5;
  }

  /* --- Entrance animation ------------------------------------------------ */

  @keyframes window-appear {
    0% { opacity: 0; transform: scale(0.35) translateY(26px) rotate(-5deg); }
    45% { opacity: 1; transform: scale(1.06) translateY(-6px) rotate(1.5deg); }
    65% { transform: scale(0.965) translateY(2px) rotate(-1deg); }
    82% { transform: scale(1.015) translateY(-1px) rotate(0.4deg); }
    100% { opacity: 1; transform: scale(1) translateY(0) rotate(0deg); }
  }

  .error-windows.is-visible .window {
    animation: window-appear 0.62s cubic-bezier(0.2, 0.9, 0.35, 1.15) both;
    animation-delay: var(--appear-delay, 0s);
  }

  /* --- Desktop (md: 768px) ----------------------------------------------- */

  @media (min-width: 768px) {
    .stage__title {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      position: absolute;
      left: 13%;
      top: 50%;
      transform: translateY(-50%);
      margin: 0;
    }

    .stage__title span {
      background: var(--ink);
      color: #fff;
      font-family: var(--font-roboto, sans-serif);
      font-size: clamp(22px, 2.5cqw, 40px);
      font-weight: 400;
      line-height: 1.3;
      padding: 0 8px;
      margin-bottom: 4px;
      text-wrap: nowrap;
    }

    /* Los dos últimos renglones van en verde y bold. */
    .stage__title span:nth-child(n + 3) {
      color: var(--accent);
      font-weight: 700;
    }

    .window {
      left: var(--l-md);
      top: var(--t-md);
      width: var(--w-md);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .window {
      opacity: 1;
    }
    .error-windows.is-visible .window {
      animation: none;
    }
  }
</style>

<script>
  import { createBlobField, initDraggableWindows } from "./errorWindows";

  function initErrorWindows(root: HTMLElement) {
    const stage = root.querySelector<HTMLElement>("[data-stage]");
    const canvas = root.querySelector<HTMLCanvasElement>("[data-blob-canvas]");
    if (!stage || !canvas) return;

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const field = createBlobField(canvas, stage);
    const cleanupDrag = initDraggableWindows(stage);

    // Con movimiento reducido el canvas quedaba en blanco: ahora se pinta un
    // solo frame fijo y no se arranca el loop.
    if (reduce) field.renderStatic();

    let inView = false;
    const sync = () => {
      if (reduce) return;
      if (inView && !document.hidden) field.play();
      else field.pause();
    };

    // Play the entrance + blobs when in view, pause the canvas when out.
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) root.classList.add("is-visible");
          inView = entry.isIntersecting;
        }
        sync();
      },
      { threshold: 0.2 },
    );
    io.observe(stage);

    // rAF ya se frena con la pestana oculta, pero en iOS Safari el canvas puede
    // seguir un rato al cambiar de app o de pestana; esto lo corta enseguida.
    document.addEventListener("visibilitychange", sync);

    document.addEventListener("astro:before-swap", () => {
      io.disconnect();
      document.removeEventListener("visibilitychange", sync);
      field.destroy();
      cleanupDrag();
    }, { once: true });
  }

  function initAll() {
    document
      .querySelectorAll<HTMLElement>("[data-error-windows]")
      .forEach(initErrorWindows);
  }

  initAll();
  document.addEventListener("astro:after-swap", initAll);
</script>
