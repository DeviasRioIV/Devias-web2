---
import {ArrowRight} from "@lucide/astro";

const { t } = Astro.props;
---

<section class="flex flex-col items-center justify-center gap-2.5 px-2.5 text-center">
  <div class="w-full relative aspect-square bg-[url('/images/blue-dither-bg.webp')] rounded-lg">

    <div class="flex flex-col z-20 w-full h-full p-6 pt-12 justify-between">
      <div class="flex flex-col items-start">
        <h2 class="text-[40px] font-univia-ultra text-white uppercase text-start">
          {t.title}
        </h2>
        <h3 class="text-[40px] font-univia-regular text-secondary uppercase">
          {t.subtitle}
        </h3>
      </div>

      <p class="text-xl font-roboto-mono text-white text-justify">
        {t.description}
      </p>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-1.5 w-full">
    <button class="h-38.5 bg-secondary rounded-lg p-6 flex flex-col justify-between">

      <div class="flex justify-end">
        <ArrowRight class="text-primary" />
      </div>

      <p class="text-primary text-xl font-roboto text-start" set:html={t.ctaEvaluate} />
    </button>

    <button class="h-38.5 bg-primary rounded-lg p-6 flex flex-col justify-between">

      <div class="flex justify-end">
        <ArrowRight class="text-white" />
      </div>

      <p class="text-white text-xl font-roboto text-start" set:html={t.ctaHowItWorks} />
    </button>
  </div>
</section>