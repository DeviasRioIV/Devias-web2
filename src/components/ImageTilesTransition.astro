---
interface Props {
  images: string[];
  cols?: number;
  rows?: number;
  displayMs?: number;
  revealMs?: number;
  staggerMs?: number;
  alt?: string;
  class?: string;
}

const {
  images = [],
  cols = 14,
  rows = 8,
  displayMs = 4000,
  revealMs = 1000,
  staggerMs = 1400,
  alt = "Image transition",
  class: className = "",
} = Astro.props as Props;

const rootId = `image-tiles-${crypto.randomUUID()}`;
const normalizedImages = images.filter(Boolean);

// Las celdas se renderizan aca, no con createElement en el cliente: Astro
// scopea el CSS con un atributo `data-astro-cid-*` que solo agrega el compilador,
// asi que un elemento creado en JS no recibiria ninguno de los estilos de abajo.
const round = (value: number) => Number(value.toFixed(4));
const tiles = Array.from({ length: rows * cols }, (_, i) => {
  const r = Math.floor(i / cols);
  const c = i % cols;
  const top = round((r / rows) * 100);
  const right = round(100 - ((c + 1) / cols) * 100);
  const bottom = round(100 - ((r + 1) / rows) * 100);
  const left = round((c / cols) * 100);
  return `inset(${top}% ${right}% ${bottom}% ${left}%)`;
});
---

<div
  id={rootId}
  class={`image-tiles-transition ${className}`.trim()}
  data-images={JSON.stringify(normalizedImages)}
  data-cols={String(cols)}
  data-rows={String(rows)}
  data-display-ms={String(displayMs)}
  data-reveal-ms={String(revealMs)}
  data-stagger-ms={String(staggerMs)}
>
  <img class="image-tiles-transition__base" alt={alt} decoding="async" />
  <div class="image-tiles-transition__tiles" aria-hidden="true">
    {tiles.map((clipPath) => <img class="image-tiles-transition__tile" alt="" decoding="async" style={`clip-path:${clipPath}`} />)}
  </div>
  <slot />
</div>

<script is:inline define:vars={{ rootId }}>
  (() => {
    const root = document.getElementById(rootId);
    if (!root) return;

    const images = JSON.parse(root.getAttribute("data-images") || "[]");
    if (!Array.isArray(images) || images.length < 2) {
      // Con una sola imagen no hay nada que animar; se muestra fija.
      const only = Array.isArray(images) ? images[0] : null;
      const base = root.querySelector(".image-tiles-transition__base");
      if (only && base instanceof HTMLImageElement) base.src = only;
      return;
    }

    const cols = Number(root.getAttribute("data-cols")) || 14;
    const rows = Number(root.getAttribute("data-rows")) || 8;
    const displayMs = Number(root.getAttribute("data-display-ms")) || 4000;
    const revealMs = Number(root.getAttribute("data-reveal-ms")) || 1000;
    const staggerMs = Number(root.getAttribute("data-stagger-ms")) || 1400;

    const baseImg = root.querySelector(".image-tiles-transition__base");
    const tiles = Array.from(root.querySelectorAll(".image-tiles-transition__tile"));
    if (!(baseImg instanceof HTMLImageElement) || tiles.length !== rows * cols) return;

    let currentIndex = 0;
    let isTransitioning = false;
    let revealFrame = null;
    let finishTimeout = null;

    baseImg.src = images[currentIndex];

    // Precarga: sin esto una celda puede revelarse antes de que su bitmap exista.
    const preloaded = new Map();
    for (const src of images) {
      const img = new Image();
      img.src = src;
      preloaded.set(src, img);
    }

    const waitForImage = (src) => {
      const img = preloaded.get(src);
      if (!(img instanceof HTMLImageElement)) return Promise.resolve();
      if (img.complete && img.naturalWidth > 0) return Promise.resolve();
      return new Promise((resolve) => {
        img.addEventListener("load", resolve, { once: true });
        img.addEventListener("error", resolve, { once: true });
      });
    };

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    // Cada celda espera un tiempo proporcional a su distancia hasta un origen
    // aleatorio (mas jitter), de modo que la grilla se llene como una onda que
    // nace en un punto distinto en cada cambio. La duracion va inline y no por
    // hoja de estilos: un `var()` dentro del shorthand `transition` es fragil y
    // dejaba el fundido en 0ms.
    const assignTimings = () => {
      // Con movimiento reducido se conserva el fundido pero se quita la onda,
      // porque un corte seco molesta mas que una disolucion suave.
      const stagger = reduceMotion.matches ? 0 : staggerMs;
      const cx = Math.random() * cols;
      const cy = Math.random() * rows;
      const maxDist = Math.hypot(Math.max(cx, cols - cx), Math.max(cy, rows - cy)) || 1;

      for (let i = 0; i < tiles.length; i++) {
        const r = Math.floor(i / cols);
        const c = i % cols;
        const dist = Math.hypot(c - cx, r - cy) / maxDist;
        const jitter = (Math.random() - 0.5) * 0.35;
        const progress = Math.max(0, Math.min(1, dist + jitter));
        tiles[i].style.transitionDuration = `${revealMs}ms`;
        tiles[i].style.transitionDelay = `${progress * stagger}ms`;
      }
    };

    const startTransition = async () => {
      if (isTransitioning) return;
      isTransitioning = true;

      const nextIndex = (currentIndex + 1) % images.length;
      const nextSrc = images[nextIndex];

      await waitForImage(nextSrc);

      // Las celdas siguen en opacity 0, asi que cambiar el src no se ve.
      for (const tile of tiles) tile.src = nextSrc;
      assignTimings();

      if (revealFrame !== null) window.cancelAnimationFrame(revealFrame);
      if (finishTimeout !== null) window.clearTimeout(finishTimeout);

      // Dos frames: el primero deja que el navegador registre el estado inicial
      // (src y delay nuevos en opacity 0), el segundo dispara la transicion.
      revealFrame = window.requestAnimationFrame(() => {
        revealFrame = window.requestAnimationFrame(() => {
          revealFrame = null;
          for (const tile of tiles) tile.style.opacity = "1";
        });
      });

      const totalMs = (reduceMotion.matches ? 0 : staggerMs) + revealMs + 60;
      finishTimeout = window.setTimeout(() => {
        finishTimeout = null;
        baseImg.src = nextSrc;
        // La base ya muestra la misma imagen, asi que devolver las celdas a 0
        // es invisible, pero hay que hacerlo sin animar para no ver un fundido
        // inverso. La duracion se vuelve a fijar en el proximo assignTimings.
        for (const tile of tiles) {
          tile.style.transitionDuration = "0ms";
          tile.style.transitionDelay = "0ms";
          tile.style.opacity = "0";
        }
        void root.offsetWidth; // fuerza el reflow para que el reset no se anime
        currentIndex = nextIndex;
        isTransitioning = false;
      }, totalMs);
    };

    const timer = window.setInterval(startTransition, displayMs);
    window.addEventListener("beforeunload", () => {
      window.clearInterval(timer);
      if (revealFrame !== null) window.cancelAnimationFrame(revealFrame);
      if (finishTimeout !== null) window.clearTimeout(finishTimeout);
    });
  })();
</script>

<style>
  .image-tiles-transition {
    position: relative;
    overflow: hidden;
    border-radius: 16px;
    background: #0b0b34;
    width: 100%;
    aspect-ratio: 16 / 10;
  }

  .image-tiles-transition__base,
  .image-tiles-transition__tile {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-tiles-transition__tiles {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .image-tiles-transition__tile {
    opacity: 0;
    /* La duracion y el delay los fija el script por celda. */
    transition-property: opacity;
    transition-duration: 0ms;
    transition-timing-function: cubic-bezier(0.33, 0, 0.67, 1);
  }
</style>
