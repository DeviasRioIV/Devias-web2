---

type DiagnosticStep = {
  title: string;
  description: string;
}

interface Props {
  t: DiagnosticStep[];
}

const { t } = Astro.props;
---

<section class="flex flex-col gap-2.5 px-2.5 md:max-w-[745px] md:mx-auto md:mt-[96px]">
  <!-- steps -->
  {
    t.map((step, index) => (
      <div class="flex gap-2.5" style={{paddingLeft: `${index * 20}px`}}>
        <span class="font-univia-ultra font-black text-[64px] text-primary leading-16">{index + 1}</span>
        <!-- card -->
        <div class="border border-outline rounded-lg p-6">
          <h4 class="font-univia-ultra uppercase text-[20px] text-primary">{step.title}</h4>
          <p class="font-roboto-mono text-[16px] text-justify text-black">{step.description}</p>
        </div>
      </div>
    ))
  }
</section>