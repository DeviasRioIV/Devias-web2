---
type footerContent = {
  aboutUs: {title: string, links: {label: string, href: string}[]};
  social: {title: string, links: {label: string, href: string}[]};
  directions: string[];
}

interface Props {
  t: footerContent;
}

const { t } = Astro.props;
---
<footer class="bg-[url('/images/blue-dither-bg.webp')] w-full px-21.25 py-12 -mt-2 -z-1">
  <!-- About us -->
  <div class="mb-8">
    <h4 class="text-white font-roboto-mono text-2xl">{t.aboutUs.title}</h4>

    <ul class="flex flex-col gap-2.25 mt-2.25">
      {
        t.aboutUs.links.map(link => (
          <li>
            <a href={link.href} class="text-white font-roboto-mono text-2xl opacity-75">{link.label}</a>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Social -->
  <div>
    <ul class="flex flex-col gap-2.25 mt-2.25">
      {
        t.social.links.map(link => (
          <li>
            <a target="_blank" rel="noopener noreferrer" href={link.href} class="text-white font-roboto-mono text-2xl opacity-75">{link.label}</a>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- directions -->
   <div class="flex flex-col gap-[1em] mt-24">
    {
      t.directions.map(dir => (
        <p class="text-white font-roboto-mono text-[16px]">{dir}</p>
      ))
    }
   </div>

   <div class="flex items-center w-full justify-center mt-12">
     <img src="/logos/Iso+Eslogan.svg" alt="Footer Image" class="w-16.25">
   </div>
</footer>