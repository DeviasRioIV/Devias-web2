---
type footerContent = {
  aboutUs: {title: string, links: {label: string, href: string}[]};
  social: {title: string, links: {label: string, href: string}[]};
  directions: string[];
}

interface Props {
  t: footerContent;
}

const { t } = Astro.props;
---
<footer class="bg-[url('/images/dither-footer.png')] bg-position-[top_right] bg-size-[700%] md:bg-size-[150%] bg-no-repeat w-full px-21.25 pt-[88px] pb-[144px] -mt-2 -z-1">
  
  <div class="max-w-205 mx-auto flex justify-between md:items-center flex-col md:flex-row gap-12 md:gap-0 items-start">
    <div>
      <!-- About us -->
      <div class="md:w-fit">
        <!-- <h4 class="text-white font-roboto-mono text-2xl">{t.aboutUs.title}</h4> -->
    
        <ul class="flex flex-col gap-2.25 mt-2.25">
          {
            t.aboutUs.links.map(link => (
              <li>
                <a href={link.href} class="text-white font-roboto-mono text-2xl opacity-75 hover:opacity-100 transition">{link.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
    
      <!-- Social -->
      <div class="mt-8">
        <ul class="flex flex-col gap-2.25">
          {
            t.social.links.map(link => (
              <li>
                <a target="_blank" rel="noopener noreferrer" href={link.href} class="text-white font-roboto-mono text-2xl opacity-75 hover:opacity-100 transition">{link.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  
    <!-- directions -->
    <div class="flex flex-col gap-[1em] md:w-fit md:max-w-73.75 h-fit">
      {
        t.directions.map(dir => (
          <p class="text-white font-roboto-mono text-[16px] text-justify">{dir}</p>
        ))
      }
    </div>
  
    <div class="flex items-center justify-center self-center">
      <img src="/logos/Iso+Eslogan.svg" alt="Footer Image" class="w-25">
    </div>
  </div>
</footer>