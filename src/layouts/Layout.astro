---
import { Font } from "astro:assets";
import "../styles/global.css";
import Header from '../components/Header.astro';
const {
  lang = "es",
  t,
  title = "Devias | Sistemas digitales para escalar tu negocio",
  description = "Ordenamos tus operaciones con sistemas digitales para que el crecimiento de tu empresa no se convierta en caos.",
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL('https://www.devias.ar');
const canonical = new URL(Astro.url.pathname, site);
const alternateEs = new URL('/es/', site);
const alternateEn = new URL('/en/', site);
const ogImage = new URL('/images/dither-hero.webp', site);
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Devias',
  url: site.href,
  logo: new URL('/logos/logo-devias.svg', site).href,
  email: 'hola@devias.ar',
  sameAs: ['https://www.linkedin.com/company/devias-ar/'],
};
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
	<link rel="icon" href="/favicon.ico" />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" hreflang="es" href={alternateEs} />
		<link rel="alternate" hreflang="en" href={alternateEn} />
		<link rel="alternate" hreflang="x-default" href={alternateEs} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<Font cssVariable="--univia-pro-regular" preload />
		<Font cssVariable="--univia-pro-ultra" preload />
		<Font cssVariable="--roboto-mono" preload />
		<Font cssVariable="--roboto" preload />
		<title>{title}</title>
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Devias" />
		<meta property="og:locale" content={lang === 'es' ? 'es_AR' : 'en_US'} />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="4003" />
		<meta property="og:image:height" content="2250" />
		<meta property="og:image:alt" content="Textura azul de Devias" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

		{import.meta.env.PROD && import.meta.env.PUBLIC_CLARITY_ID && (
			<script is:inline define:vars={{ id: import.meta.env.PUBLIC_CLARITY_ID }}>
				(function (c, l, a, r, i, t, y) {
					c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments) };
					t = l.createElement(r); t.async = 1; t.src = "https://www.clarity.ms/tag/" + i;
					y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
				})(window, document, "clarity", "script", id);
			</script>
		)}

	</head>
	<body>
		<Header lang={lang} t={t.header} />
		<slot />

		{/* Scroll suave solo para links a anclas de la misma página. Con
		    `scroll-behavior: smooth` en el CSS, el navegador también animaba la
		    restauración de scroll al volver con "atrás" (arrancaba desde arriba). */}
		<script>
			document.addEventListener("click", (event) => {
				if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
				const link = (event.target as Element).closest<HTMLAnchorElement>("a[href]");
				if (!link || link.target || link.origin !== location.origin || link.pathname !== location.pathname || !link.hash) return;

				const target = document.getElementById(decodeURIComponent(link.hash.slice(1)));
				if (!target) return;

				event.preventDefault();
				const smooth = !window.matchMedia("(prefers-reduced-motion: reduce)").matches;
				target.scrollIntoView({ behavior: smooth ? "smooth" : "auto" });
				history.pushState(null, "", link.hash);
			});
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
