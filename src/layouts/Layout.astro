---
import { Font } from "astro:assets";
import "../styles/global.css";
import Header from '../components/Header.astro';
const { lang = "es", t } = Astro.props;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<Font cssVariable="--univia-pro-regular" preload />
		<Font cssVariable="--univia-pro-ultra" preload />
		<Font cssVariable="--roboto-mono" preload />
		<Font cssVariable="--roboto" preload />
		<title>Devias</title>

		{import.meta.env.PROD && import.meta.env.PUBLIC_CLARITY_ID && (
			<script is:inline define:vars={{ id: import.meta.env.PUBLIC_CLARITY_ID }}>
				(function (c, l, a, r, i, t, y) {
					c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments) };
					t = l.createElement(r); t.async = 1; t.src = "https://www.clarity.ms/tag/" + i;
					y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
				})(window, document, "clarity", "script", id);
			</script>
		)}

	</head>
	<body>
		<Header lang={lang} t={t.header} />
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
