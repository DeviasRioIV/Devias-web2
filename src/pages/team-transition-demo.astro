---
import ImageTilesTransition from "../components/ImageTilesTransition.astro";

const teamImages = [
  "/images/team/devias-team-dither-dark-1.png",
  "/images/team/devias-team-dither-dark-2.png",
  "/images/team/devias-team-dither-dark-3.png",
  "/images/team/devias-team-dither-dark-4.png",
  "/images/team/devias-team-dither-dark-5.png",
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Demo transicion de imagenes</title>
  </head>
  <body>
    <main class="demo-page">

      <ImageTilesTransition
        images={teamImages}
        cols={14}
        rows={8}
        displayMs={4000}
        revealMs={1000}
        staggerMs={1400}
        alt="Fotos del equipo Devias"
      />
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
  }

  body {
    margin: 0;
    min-height: 100vh;
    font-family: "Roboto", sans-serif;
    background: radial-gradient(circle at 20% 20%, #f3f6ff 0%, #e9eeff 42%, #dde5ff 100%);
    color: #0f1d57;
  }

  .demo-page {
    max-width: 1040px;
    margin: 0 auto;
    padding: 48px 20px;
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    line-height: 1.05;
  }

  p {
    margin: 14px 0 28px;
    max-width: 760px;
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.55;
  }
</style>
