---
import Layout from '../../layouts/Layout.astro';
import DiagnosticSteps from '../../components/DiagnosticSteps.astro';
import HeroSection from '../../components/HeroSection.astro';
import ScaleChartReveal from '../../components/ScaleChartReveal.astro';
import ErrorWindows from '../../components/ErrorWindows/ErrorWindows.astro';
import TwoStepsContactForm from '../../components/TwoStepsContactForm/TwoStepsContactForm.astro';
import SimpleContactForm from '../../components/SimpleContactForm/ContactForm.astro';
import { getTranslations } from '../../i18n/utils';
import GridBackground from '../../components/GridBackground.astro';
import Footer from '../../components/Footer.astro';
import { ArrowRight } from '@lucide/astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params;
const t = getTranslations(lang);
---

<Layout lang={lang} t={t}>
	<HeroSection t={t.hero} />

  <main class="bg-white rounded-b-lg z-10 relative pb-10">
    <div class="flex justify-center px-2.5 md:px-5 py-10">
      <TwoStepsContactForm t={t.contact} lang={lang} />
    </div>
  
    {/* En desktop el título va dentro del stage de <ErrorWindows>, a la
        izquierda de las ventanas; en mobile queda arriba del bloque. */}
    <div id="operational-chaos">
      <h3 class="flex flex-col px-2.5 mb-12 md:hidden">
        {t.homeTexts.operationalChaosTitle.map((line, i) => (
          <span class={`inline max-w-fit font-roboto text-[32px] bg-primary mb-1 px-2 ${i<=1 ? 'text-white' : 'text-secondary font-bold'}`}>{line}</span>
        ))}
      </h3>

      <ErrorWindows t={t.errorWindows} title={t.homeTexts.operationalChaosTitle} />
    </div>
  
    <p class="max-w-md px-2.5 py-10 text-primary text-[22px] leading-relaxed md:max-w-186.25 md:mx-auto md:text-[40px] md:py-36">
      {t.homeTexts.notFastProblem.noUnderline}
      <b class="hand-underline">{t.homeTexts.notFastProblem.underline}</b>
    </p>
  
    <h3 class="flex flex-col px-2.5 mb-12 md:hidden">
      {t.homeTexts.growingUpIsNotAProblem.map((line, i) => (
        <span class={`inline max-w-fit font-roboto text-[32px] bg-primary mb-1 px-2 ${i<=1 ? 'text-white' : 'text-secondary font-bold'}`}>{line}</span>
      ))}
    </h3>

    <div class="flex-col hidden md:flex bg-primary p-0 py-48 items-center">
      <h3>
        <span class="inline max-w-fit font-roboto text-[64px] bg-primary text-white">
          {t.homeTexts.growingUpIsNotAProblem[0]} {t.homeTexts.growingUpIsNotAProblem[1]}
        </span>
        <br>
        <span class="inline max-w-fit font-roboto text-[64px] bg-primary text-secondary font-bold">
          {t.homeTexts.growingUpIsNotAProblem[2]} {t.homeTexts.growingUpIsNotAProblem[3]}
        </span>
      </h3>
    </div>
  
    <p class="max-w-md px-2.5 py-10 text-primary text-[22px] leading-relaxed md:text-[40px] md:max-w-186.25 md:mx-auto md:mt-36 md:text-justify">
      {t.homeTexts.smallSystem.noUnderline}
      <b class="hand-underline"> {t.homeTexts.smallSystem.underline}</b>
    </p>
  
    <ScaleChartReveal scale={t.scale} contact={t.contact} lang={lang} />
  
    <h3 class="flex flex-col px-2.5 mb-12 mt-12 md:w-fit md:mx-auto md:mt-36" id="we-dont-sell-hours">
      {t.homeTexts.weDontSellHours.map((line, i) => (
        <span class={`inline max-w-fit font-roboto text-[32px] bg-primary mb-1 px-2 ${i<=1 ? 'text-white' : 'text-secondary font-bold'}`}>{line}</span>
      ))}
    </h3>
  
    <DiagnosticSteps t={t.diagnosticSteps} />
  
    <div class="relative w-full py-25 px-2.5 mt-12 md:p-0" id="our-clients">

      <!-- <div class="md:max-w-186.5 md:mx-auto md:py-24">
        <GridBackground />
    
        <h3 class="flex flex-col">
          {t.homeTexts.Leaders.map((line, i) => (
            <span class={`inline max-w-fit font-roboto text-[32px] bg-primary mb-1 px-2 ${i<=1 ? 'text-white' : 'text-secondary font-bold'}`}>{line}</span>
          ))}
        </h3>
  
        <div class="grid grid-cols-2 grid-rows-[154px_154px] gap-1.75 mt-10 md:grid-rows-[220px_220px]">
          <button class="relative flex items-center justify-center bg-white border border-outline rounded-lg row-span-2 p-8 md:p-14 cursor-pointer" aria-label="Bucked Up">
            <span class="client-logo" style="--logo: url('/logos/projects/bucked.png')"></span>
            <ArrowRight class="absolute right-5 top-5 stroke-primary w-6 h-6" />
          </button>

          <button class="relative flex items-center justify-center bg-white border border-outline rounded-lg p-6 pr-14 md:p-10 md:pr-16 cursor-pointer" aria-label="Hexagon">
            <span class="client-logo" style="--logo: url('/logos/projects/hexagon.png')"></span>
            <ArrowRight class="absolute right-5 top-5 stroke-primary w-6 h-6" />
          </button>

          <button class="relative flex items-center justify-center bg-white border border-outline rounded-lg p-6 pr-14 md:p-10 md:pr-16 cursor-pointer" aria-label="Reef Check">
            <span class="client-logo" style="--logo: url('/logos/projects/reefCheck.png')"></span>
            <ArrowRight class="absolute right-5 top-5 stroke-primary w-6 h-6" />
          </button>
        </div>
      </div> -->
    </div>
  
    <div class='flex flex-col px-2.5 my-12 md:max-w-205 md:mx-auto md:py-36'>
      <h5 class="font-univia-ultra text-[40px] text-primary uppercase md:text-[64px] md:leading-[110%]">
        {t.homeTexts.yourNextDecision.blue}
      </h5>
  
      <h5 class="font-univia-ultra text-[40px] text-secondary uppercase md:text-[64px] md:leading-[110%]">
        {t.homeTexts.yourNextDecision.green}
      </h5>
    </div>
  
    <div class="px-2.5" id="last-contact-form">
      <SimpleContactForm t={t.contact} lang={lang} shadow={true} />
    </div>
  </main>

  <Footer t={t.footer} />
</Layout>

<style>
  /* Los logos de clientes son PNG negros con transparencia. En vez de pintarlos
     con filtros (impreciso), los usamos como máscara: el color lo pone el
     background, así quedan exactamente en el azul de marca. `contain` los
     encierra dentro del padding de la card, sin desbordar. */
  .client-logo {
    display: block;
    width: 100%;
    height: 100%;
    background-color: var(--color-primary);
    -webkit-mask: var(--logo) center / contain no-repeat;
    mask: var(--logo) center / contain no-repeat;
  }
</style>
