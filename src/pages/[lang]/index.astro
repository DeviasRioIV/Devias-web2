---
import Layout from '../../layouts/Layout.astro';
import DiagnosticSteps from '../../components/DiagnosticSteps.astro';
import HeroSection from '../../components/HeroSection.astro';
import ScaleChart from '../../components/ScaleChart/ScaleChart.astro';
import ErrorWindows from '../../components/ErrorWindows/ErrorWindows.astro';
import TwoStepsContactForm from '../../components/TwoStepsContactForm/TwoStepsContactForm.astro';
import SimpleContactForm from '../../components/SimpleContactForm/ContactForm.astro';
import { getTranslations } from '../../i18n/utils';
import GridBackground from '../../components/GridBackground.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params;
const t = getTranslations(lang);
---

<Layout lang={lang} t={t}>
	<HeroSection t={t.hero} />

  <div class="flex justify-center px-2.5 py-10">
    <TwoStepsContactForm t={t.contact} lang={lang} />
  </div>

  <h3 class="flex flex-col px-2.5 mb-12">
    {t.homeTexts.operationalChaosTitle.map((line, i) => (
      <span class={`inline max-w-fit font-roboto text-[32px] bg-primary mb-1 px-2 ${i<=1 ? 'text-white' : 'text-secondary font-bold'}`}>{line}</span>
    ))}
  </h3>

  <ErrorWindows t={t.errorWindows} />

  <p class="max-w-md px-2.5 py-10 text-primary text-[22px] leading-relaxed">
    {t.homeTexts.notFastProblem.noUnderline}
    <b class="hand-underline">{t.homeTexts.notFastProblem.underline}</b>
  </p>

  <h3 class="flex flex-col px-2.5 mb-12">
    {t.homeTexts.growingUpIsNotAProblem.map((line, i) => (
      <span class={`inline max-w-fit font-roboto text-[32px] bg-primary mb-1 px-2 ${i<=1 ? 'text-white' : 'text-secondary font-bold'}`}>{line}</span>
    ))}
  </h3>

  <p class="max-w-md px-2.5 py-10 text-primary text-[22px] leading-relaxed">
    {t.homeTexts.smallSystem.noUnderline}
    <b class="hand-underline"> {t.homeTexts.smallSystem.underline}</b>
  </p>

  <ScaleChart t={t.scale} />

  <h3 class="flex flex-col px-2.5 mb-12 mt-12">
    {t.homeTexts.weDontSellHours.map((line, i) => (
      <span class={`inline max-w-fit font-roboto text-[32px] bg-primary mb-1 px-2 ${i<=1 ? 'text-white' : 'text-secondary font-bold'}`}>{line}</span>
    ))}
  </h3>

  <DiagnosticSteps t={t.diagnosticSteps} />

  <!-- <SimpleContactForm t={t.contact} lang={lang} /> -->
  <!-- <GridBackground /> -->
</Layout>
