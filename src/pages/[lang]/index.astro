---
import Layout from '../../layouts/Layout.astro';
import HeroSection from '../../components/HeroSection.astro';
import ScaleChart from '../../components/ScaleChart/ScaleChart.astro';
import ErrorWindows from '../../components/ErrorWindows/ErrorWindows.astro';
import { getTranslations } from '../../i18n/utils';
import GridBackground from '../../components/GridBackground.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params;
const t = getTranslations(lang);
---

<Layout lang={lang} t={t}>
	<HeroSection t={t.hero} />
  <div class="relative h-screen w-full">
    <ScaleChart t={t.scale} />
    <GridBackground />
    <ErrorWindows t={t.errorWindows} />
  </div>
</Layout>
