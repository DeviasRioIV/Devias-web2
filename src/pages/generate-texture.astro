<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>Generador de texturas dither — vectorial</title>
<style>
  :root{
    --bg: #000014;
    --panel: #050518;
    --panel-border: #1a1a3d;
    --accent: #0000FF;
    --accent-glow: #3355ff;
    --text: #c9d0ff;
    --text-dim: #6b6f9a;
    --mono: "IBM Plex Mono","JetBrains Mono","Courier New",monospace;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;background:var(--bg);color:var(--text);font-family:var(--mono);}
  body{padding:20px;min-height:100vh;}
  .app{max-width:1180px;margin:0 auto;}
  header{margin-bottom:18px;border-bottom:1px solid var(--panel-border);padding-bottom:14px;}
  header h1{font-size:15px;letter-spacing:.12em;text-transform:uppercase;margin:0 0 4px;color:var(--text);font-weight:600;}
  header h1 span{color:var(--accent-glow);}
  header p{margin:0;font-size:11px;color:var(--text-dim);letter-spacing:.02em;}

  .layout{display:grid;grid-template-columns:260px 1fr;gap:18px;}
  @media (max-width:860px){.layout{grid-template-columns:1fr;}}

  .panel{background:var(--panel);border:1px solid var(--panel-border);padding:14px;}
  .controls{display:flex;flex-direction:column;gap:14px;height:fit-content;}
  .field{display:flex;flex-direction:column;gap:5px;}
  .field-row{display:flex;gap:10px;}
  .field-row .field{flex:1;}
  label{font-size:10px;text-transform:uppercase;letter-spacing:.08em;color:var(--text-dim);display:flex;justify-content:space-between;}
  label b{color:var(--accent-glow);font-weight:600;}
  input[type=range]{-webkit-appearance:none;width:100%;height:2px;background:var(--panel-border);outline:none;}
  input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:10px;height:10px;background:var(--accent-glow);border-radius:0;cursor:pointer;box-shadow:0 0 6px var(--accent-glow);}
  input[type=range]::-moz-range-thumb{width:10px;height:10px;background:var(--accent-glow);border:none;border-radius:0;cursor:pointer;}
  select, input[type=number], input[type=color]{
    background:#0a0a25;border:1px solid var(--panel-border);color:var(--text);
    font-family:var(--mono);font-size:11px;padding:6px 7px;width:100%;
  }
  input[type=color]{padding:2px;height:28px;cursor:pointer;}
  select{cursor:pointer;}
  .divider{height:1px;background:var(--panel-border);margin:2px 0;}
  .checkbox-field{flex-direction:row;align-items:center;gap:8px;}
  .checkbox-field input{accent-color:var(--accent-glow);}

  button{
    font-family:var(--mono);font-size:11px;letter-spacing:.05em;text-transform:uppercase;
    background:transparent;border:1px solid var(--accent-glow);color:var(--accent-glow);
    padding:9px 10px;cursor:pointer;transition:background .12s,color .12s;
  }
  button:hover{background:var(--accent-glow);color:#000014;}
  button.primary{background:var(--accent-glow);color:#000014;}
  button.primary:hover{background:var(--text);border-color:var(--text);}
  button.ghost{border-color:var(--panel-border);color:var(--text-dim);}
  button.ghost:hover{background:var(--panel-border);color:var(--text);}
  .btn-row{display:flex;gap:8px;flex-wrap:wrap;}
  .btn-row button{flex:1;min-width:110px;}

  main{display:flex;flex-direction:column;gap:14px;}
  .canvas-wrap{
    background:var(--panel);border:1px solid var(--panel-border);
    display:flex;align-items:center;justify-content:center;padding:16px;
  }
  #preview{width:100%;height:auto;image-rendering:pixelated;display:block;border:1px solid var(--panel-border);}

  .meta{display:flex;justify-content:space-between;font-size:10px;color:var(--text-dim);padding:0 2px;}
  .meta b{color:var(--accent-glow);}

  .variants{display:grid;grid-template-columns:repeat(6,1fr);gap:8px;}
  @media (max-width:700px){.variants{grid-template-columns:repeat(3,1fr);}}
  .variant-thumb{
    aspect-ratio:16/10;border:1px solid var(--panel-border);cursor:pointer;position:relative;overflow:hidden;
    background:#000;transition:border-color .12s;
  }
  .variant-thumb canvas{width:100%;height:100%;image-rendering:pixelated;display:block;}
  .variant-thumb:hover{border-color:var(--accent-glow);}
  .variant-thumb.active{border-color:var(--accent-glow);box-shadow:0 0 0 1px var(--accent-glow);}

  .modal-overlay{
    position:fixed;inset:0;background:rgba(0,0,10,.85);display:flex;align-items:center;justify-content:center;
    z-index:50;padding:20px;
  }
  .modal-overlay.hidden{display:none;}
  .modal{background:var(--panel);border:1px solid var(--accent-glow);max-width:760px;width:100%;max-height:85vh;display:flex;flex-direction:column;}
  .modal-head{display:flex;justify-content:space-between;align-items:center;padding:12px 14px;border-bottom:1px solid var(--panel-border);}
  .modal-head span{font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:var(--text-dim);}
  .modal-head button{padding:4px 10px;}
  .modal-body{overflow:auto;padding:14px;}
  .modal-body pre{margin:0;font-size:11px;line-height:1.5;color:var(--text);white-space:pre-wrap;word-break:break-word;}
  .modal-foot{display:flex;gap:8px;padding:10px 14px;border-top:1px solid var(--panel-border);}

  .hint{font-size:10px;color:var(--text-dim);line-height:1.5;}
</style>
</head>
<body>
<div class="app max-w-screen max-h-screen">
  <header>
    <h1>Dither<span>Forge</span> — generador de texturas vectoriales</h1>
    <p>Ordered dithering (Bayer) + difusión de error (Atkinson) sobre un campo de ruido con seed. Salida 100% vectorial: cada punto es un &lt;rect&gt; real, no un PNG escondido.</p>
  </header>

  <div class="layout">
    <aside class="panel controls">

      <div class="field">
        <label>Seed <b id="seedLabel">—</b></label>
        <div class="field-row">
          <input type="number" id="seedInput" step="1" min="0">
          <button id="randomSeedBtn" style="flex:0 0 auto;">🎲</button>
        </div>
      </div>

      <div class="divider"></div>

      <div class="field">
        <label>Patrón de dither</label>
        <select id="patternSelect">
          <option value="atkinson">Atkinson (difusión de error)</option>
          <option value="bayer2">Bayer 2×2</option>
          <option value="bayer4">Bayer 4×4</option>
          <option value="bayer8">Bayer 8×8</option>
          <option value="random">Ruido aleatorio (blue-noise-ish)</option>
        </select>
      </div>

      <div class="field">
        <label>Tamaño de celda <b id="cellLabel">6px</b></label>
        <input type="range" id="cellSize" min="3" max="16" step="1" value="6">
      </div>

      <div class="divider"></div>

      <div class="field">
        <label>Ángulo de luz <b id="angleLabel">35°</b></label>
        <input type="range" id="angle" min="0" max="360" step="1" value="35">
      </div>

      <div class="field">
        <label>Escala de ruido <b id="noiseScaleLabel">3.2</b></label>
        <input type="range" id="noiseScale" min="0.5" max="8" step="0.1" value="3.2">
      </div>

      <div class="field">
        <label>Peso del ruido <b id="noiseWeightLabel">0.55</b></label>
        <input type="range" id="noiseWeight" min="0" max="1" step="0.01" value="0.55">
      </div>

      <div class="field">
        <label>Octavas de ruido <b id="octavesLabel">3</b></label>
        <input type="range" id="octaves" min="1" max="6" step="1" value="3">
      </div>

      <div class="field">
        <label>Contraste <b id="contrastLabel">1.4</b></label>
        <input type="range" id="contrast" min="0.3" max="3" step="0.1" value="1.4">
      </div>

      <div class="field">
        <label>Densidad (bias) <b id="biasLabel">0.00</b></label>
        <input type="range" id="bias" min="-0.4" max="0.4" step="0.01" value="0">
      </div>

      <div class="divider"></div>

      <div class="field-row">
        <div class="field">
          <label>Fondo</label>
          <input type="color" id="bgColor" value="#000014">
        </div>
        <div class="field">
          <label>Acento</label>
          <input type="color" id="accentColor" value="#0000ff">
        </div>
      </div>

      <div class="field checkbox-field">
        <input type="checkbox" id="invertToggle">
        <label style="text-transform:none;font-size:11px;">Invertir densidad</label>
      </div>

      <div class="divider"></div>

      <div class="btn-row">
        <button class="primary" id="newVariantBtn">Nueva variación</button>
      </div>
      <div class="btn-row">
        <button id="exportPngBtn">Export PNG</button>
        <button id="exportSvgBtn">Export SVG</button>
      </div>
      <div class="btn-row">
        <button class="ghost" id="exportJsBtn">Ver / exportar código JS</button>
      </div>

      <p class="hint">El SVG exportado usa &lt;rect&gt; agrupados por fila (run-length), sin imágenes embebidas. Escala a cualquier resolución sin perder nitidez.</p>
    </aside>

    <main>
      <div class="canvas-wrap">
        <canvas id="preview" width="800" height="480"></canvas>
      </div>
      <div class="meta">
        <span>Grid: <b id="gridInfo">—</b></span>
        <span>Celdas activas: <b id="activeInfo">—</b></span>
        <span>Patrón: <b id="patternInfo">—</b></span>
      </div>

      <div>
        <label style="margin-bottom:8px;display:block;">Variaciones (mismo estilo, distinto seed)</label>
        <div class="variants" id="variants"></div>
      </div>
    </main>
  </div>
</div>

<div class="modal-overlay hidden" id="codeModal">
  <div class="modal">
    <div class="modal-head">
      <span>generateDitherTexture.js</span>
      <button id="closeModalBtn">Cerrar ✕</button>
    </div>
    <div class="modal-body"><pre id="codeOutput"></pre></div>
    <div class="modal-foot">
      <button class="primary" id="copyCodeBtn">Copiar código</button>
      <button id="downloadJsBtn">Descargar .js</button>
    </div>
  </div>
</div>

<script>
// ---------- PRNG determinístico ----------
function mulberry32(seed){
  let a = seed >>> 0;
  return function(){
    a = (a + 0x6D2B79F5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

// ---------- Campo de ruido (fractal, seeded) ----------
function buildNoiseField(seed, octaves){
  const rand = mulberry32(seed);
  const layers = [];
  for(let i = 0; i < octaves; i++){
    layers.push({
      fx: (rand() * 2.5 + 0.6) * (i + 1),
      fy: (rand() * 2.5 + 0.6) * (i + 1),
      phase: rand() * Math.PI * 2,
      amp: 1 / (i + 1.4)
    });
  }
  return function(x, y){
    let v = 0, norm = 0;
    for(const L of layers){
      v += Math.sin(x * L.fx + y * L.fy + L.phase) * L.amp;
      norm += L.amp;
    }
    return (v / norm + 1) / 2; // 0..1
  };
}

// ---------- Matrices de Bayer (ordered dithering) ----------
const BAYER = {
  bayer2: { size: 2, m: [[0,2],[3,1]] },
  bayer4: { size: 4, m: [[0,8,2,10],[12,4,14,6],[3,11,1,9],[15,7,13,5]] },
  bayer8: { size: 8, m: [
    [0,32,8,40,2,34,10,42],[48,16,56,24,50,18,58,26],
    [12,44,4,36,14,46,6,38],[60,28,52,20,62,30,54,22],
    [3,35,11,43,1,33,9,41],[51,19,59,27,49,17,57,25],
    [15,47,7,39,13,45,5,37],[63,31,55,23,61,29,53,21]
  ]}
};

// ---------- Campo de densidad: gradiente direccional + ruido ----------
function densityAt(nx, ny, noiseFn, opt){
  const rad = opt.angle * Math.PI / 180;
  const dx = Math.cos(rad), dy = Math.sin(rad);
  let g = ((nx - 0.5) * dx + (ny - 0.5) * dy) + 0.5;
  g = Math.min(1, Math.max(0, g));
  const n = noiseFn(nx * opt.noiseScale, ny * opt.noiseScale);
  let d = g * (1 - opt.noiseWeight) + n * opt.noiseWeight;
  d = Math.pow(Math.min(1, Math.max(0, d)), opt.contrast);
  d = Math.min(1, Math.max(0, d + opt.bias));
  if(opt.invert) d = 1 - d;
  return d;
}

// ---------- Dithering: produce grid binario (0/1) ----------
function ditherGrid(cols, rows, noiseFn, opt){
  const grid = new Float32Array(cols * rows);
  for(let y = 0; y < rows; y++){
    for(let x = 0; x < cols; x++){
      grid[y * cols + x] = densityAt(x / cols, y / rows, noiseFn, opt);
    }
  }
  const out = new Uint8Array(cols * rows);

  if(opt.pattern === "atkinson"){
    // Difusión de error tipo Atkinson (8/8 del error a 6 vecinos)
    for(let y = 0; y < rows; y++){
      for(let x = 0; x < cols; x++){
        const i = y * cols + x;
        const old = grid[i];
        const nw = old > 0.5 ? 1 : 0;
        out[i] = nw;
        const err = (old - nw) / 8;
        const add = (dx, dy) => {
          const xx = x + dx, yy = y + dy;
          if(xx >= 0 && xx < cols && yy >= 0 && yy < rows) grid[yy * cols + xx] += err;
        };
        add(1,0); add(2,0); add(-1,1); add(0,1); add(1,1); add(0,2);
      }
    }
  } else if(opt.pattern === "random"){
    const rand = mulberry32(opt.seed ^ 0x9e3779b9);
    for(let i = 0; i < grid.length; i++) out[i] = grid[i] > rand() ? 1 : 0;
  } else {
    const B = BAYER[opt.pattern] || BAYER.bayer4;
    for(let y = 0; y < rows; y++){
      for(let x = 0; x < cols; x++){
        const i = y * cols + x;
        const th = (B.m[y % B.size][x % B.size] + 0.5) / (B.size * B.size);
        out[i] = grid[i] > th ? 1 : 0;
      }
    }
  }
  return out;
}

// ---------- RLE por fila: agrupa celdas activas contiguas en un solo rect ----------
function rleRects(binGrid, cols, rows){
  const rects = [];
  for(let y = 0; y < rows; y++){
    let runStart = -1;
    for(let x = 0; x <= cols; x++){
      const on = x < cols && binGrid[y * cols + x] === 1;
      if(on && runStart === -1) runStart = x;
      if(!on && runStart !== -1){
        rects.push({ x: runStart, y, w: x - runStart, h: 1 });
        runStart = -1;
      }
    }
  }
  return rects;
}

// ---------- Genera una textura completa a partir de parámetros ----------
function generateDitherTexture(opts){
  const o = Object.assign({
    seed: 1, width: 800, height: 480, cellSize: 6,
    pattern: "atkinson", angle: 35, noiseScale: 3.2, noiseWeight: 0.55,
    octaves: 3, contrast: 1.4, bias: 0, invert: false
  }, opts);
  const cols = Math.max(4, Math.round(o.width / o.cellSize));
  const rows = Math.max(4, Math.round(o.height / o.cellSize));
  const noiseFn = buildNoiseField(o.seed, o.octaves);
  const bin = ditherGrid(cols, rows, noiseFn, Object.assign({}, o));
  const rects = rleRects(bin, cols, rows);
  let active = 0;
  for(const r of rects) active += r.w * r.h;
  return { cols, rows, cellSize: o.cellSize, rects, active, opts: o };
}

// ---------- Render a canvas ----------
function renderToCanvas(canvas, result, bg, accent){
  const { cols, rows, cellSize, rects } = result;
  canvas.width = cols * cellSize;
  canvas.height = rows * cellSize;
  const ctx = canvas.getContext("2d");
  ctx.fillStyle = bg;
  ctx.fillRect(0, 0, canvas.width, canvas.height);
  ctx.fillStyle = accent;
  for(const r of rects){
    ctx.fillRect(r.x * cellSize, r.y * cellSize, r.w * cellSize, r.h * cellSize);
  }
}

// ---------- Construye SVG vectorial real (sin bitmap embebido) ----------
function buildSvgString(result, bg, accent){
  const { cols, rows, cellSize, rects } = result;
  const W = cols * cellSize, H = rows * cellSize;
  let body = `<rect width="${W}" height="${H}" fill="${bg}"/>`;
  for(const r of rects){
    body += `<rect x="${r.x*cellSize}" y="${r.y*cellSize}" width="${r.w*cellSize}" height="${r.h*cellSize}" fill="${accent}"/>`;
  }
  return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${W} ${H}" width="${W}" height="${H}" shape-rendering="crispEdges">${body}</svg>`;
}

// =====================================================================
// UI wiring
// =====================================================================
const els = {
  seedInput: document.getElementById("seedInput"),
  seedLabel: document.getElementById("seedLabel"),
  randomSeedBtn: document.getElementById("randomSeedBtn"),
  pattern: document.getElementById("patternSelect"),
  cellSize: document.getElementById("cellSize"),
  cellLabel: document.getElementById("cellLabel"),
  angle: document.getElementById("angle"),
  angleLabel: document.getElementById("angleLabel"),
  noiseScale: document.getElementById("noiseScale"),
  noiseScaleLabel: document.getElementById("noiseScaleLabel"),
  noiseWeight: document.getElementById("noiseWeight"),
  noiseWeightLabel: document.getElementById("noiseWeightLabel"),
  octaves: document.getElementById("octaves"),
  octavesLabel: document.getElementById("octavesLabel"),
  contrast: document.getElementById("contrast"),
  contrastLabel: document.getElementById("contrastLabel"),
  bias: document.getElementById("bias"),
  biasLabel: document.getElementById("biasLabel"),
  bgColor: document.getElementById("bgColor"),
  accentColor: document.getElementById("accentColor"),
  invert: document.getElementById("invertToggle"),
  preview: document.getElementById("preview"),
  gridInfo: document.getElementById("gridInfo"),
  activeInfo: document.getElementById("activeInfo"),
  patternInfo: document.getElementById("patternInfo"),
  variants: document.getElementById("variants"),
  newVariantBtn: document.getElementById("newVariantBtn"),
  exportPngBtn: document.getElementById("exportPngBtn"),
  exportSvgBtn: document.getElementById("exportSvgBtn"),
  exportJsBtn: document.getElementById("exportJsBtn"),
  codeModal: document.getElementById("codeModal"),
  codeOutput: document.getElementById("codeOutput"),
  closeModalBtn: document.getElementById("closeModalBtn"),
  copyCodeBtn: document.getElementById("copyCodeBtn"),
  downloadJsBtn: document.getElementById("downloadJsBtn"),
};

let lastResult = null;
let variantSeeds = [];

function currentOpts(seed){
  return {
    seed: seed,
    width: 800, height: 480,
    cellSize: parseInt(els.cellSize.value, 10),
    pattern: els.pattern.value,
    angle: parseFloat(els.angle.value),
    noiseScale: parseFloat(els.noiseScale.value),
    noiseWeight: parseFloat(els.noiseWeight.value),
    octaves: parseInt(els.octaves.value, 10),
    contrast: parseFloat(els.contrast.value),
    bias: parseFloat(els.bias.value),
    invert: els.invert.checked
  };
}

function refreshLabels(){
  els.cellLabel.textContent = els.cellSize.value + "px";
  els.angleLabel.textContent = els.angle.value + "°";
  els.noiseScaleLabel.textContent = parseFloat(els.noiseScale.value).toFixed(1);
  els.noiseWeightLabel.textContent = parseFloat(els.noiseWeight.value).toFixed(2);
  els.octavesLabel.textContent = els.octaves.value;
  els.contrastLabel.textContent = parseFloat(els.contrast.value).toFixed(1);
  els.biasLabel.textContent = parseFloat(els.bias.value).toFixed(2);
  els.seedLabel.textContent = els.seedInput.value;
}

function renderMain(){
  refreshLabels();
  const seed = parseInt(els.seedInput.value, 10) || 0;
  const opts = currentOpts(seed);
  lastResult = generateDitherTexture(opts);
  renderToCanvas(els.preview, lastResult, els.bgColor.value, els.accentColor.value);
  els.gridInfo.textContent = `${lastResult.cols}×${lastResult.rows} celdas`;
  els.activeInfo.textContent = `${lastResult.active} / ${lastResult.cols*lastResult.rows}`;
  els.patternInfo.textContent = els.pattern.options[els.pattern.selectedIndex].text;
  highlightActiveThumb(seed);
}

function renderVariants(){
  els.variants.innerHTML = "";
  variantSeeds = [];
  for(let i = 0; i < 6; i++){
    const seed = Math.floor(Math.random() * 1e9);
    variantSeeds.push(seed);
    const wrap = document.createElement("div");
    wrap.className = "variant-thumb";
    wrap.dataset.seed = seed;
    const c = document.createElement("canvas");
    wrap.appendChild(c);
    els.variants.appendChild(wrap);
    const opts = currentOpts(seed);
    opts.cellSize = Math.max(opts.cellSize, 6);
    const res = generateDitherTexture(opts);
    renderToCanvas(c, res, els.bgColor.value, els.accentColor.value);
    wrap.addEventListener("click", () => {
      els.seedInput.value = seed;
      renderMain();
    });
  }
}

function highlightActiveThumb(seed){
  document.querySelectorAll(".variant-thumb").forEach(el => {
    el.classList.toggle("active", parseInt(el.dataset.seed, 10) === seed);
  });
}

function download(filename, content, mime){
  const blob = new Blob([content], { type: mime });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url; a.download = filename;
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  URL.revokeObjectURL(url);
}

// --- listeners: controles regeneran solo el preview principal (rápido) ---
["input","change"].forEach(evt => {
  [els.pattern, els.cellSize, els.angle, els.noiseScale, els.noiseWeight,
   els.octaves, els.contrast, els.bias, els.bgColor, els.accentColor, els.invert, els.seedInput]
   .forEach(el => el.addEventListener(evt, renderMain));
});

els.randomSeedBtn.addEventListener("click", () => {
  els.seedInput.value = Math.floor(Math.random() * 1e9);
  renderMain();
});

els.newVariantBtn.addEventListener("click", () => {
  els.seedInput.value = Math.floor(Math.random() * 1e9);
  renderMain();
  renderVariants();
});

els.exportPngBtn.addEventListener("click", () => {
  els.preview.toBlob(blob => {
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url; a.download = `dither-${els.seedInput.value}.png`;
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }, "image/png");
});

els.exportSvgBtn.addEventListener("click", () => {
  const svg = buildSvgString(lastResult, els.bgColor.value, els.accentColor.value);
  download(`dither-${els.seedInput.value}.svg`, svg, "image/svg+xml");
});

function buildJsExport(){
  const opts = currentOpts(parseInt(els.seedInput.value, 10) || 0);
  const fnsSource = [
    mulberry32, buildNoiseField, densityAt, ditherGrid, rleRects, generateDitherTexture, buildSvgString
  ].map(f => f.toString()).join("\n\n");
  const bayerSource = "const BAYER = " + JSON.stringify(BAYER, null, 2) + ";";
  return `// Generador de textura dither — código vectorial autocontenido
// Parámetros usados en esta variación:
const PRESET = ${JSON.stringify(opts, null, 2)};

${bayerSource}

${fnsSource}

// Uso:
// const result = generateDitherTexture(PRESET);
// const svg = buildSvgString(result, "${els.bgColor.value}", "${els.accentColor.value}");
// document.body.innerHTML = svg; // o guardalo como .svg
`;
}

els.exportJsBtn.addEventListener("click", () => {
  els.codeOutput.textContent = buildJsExport();
  els.codeModal.classList.remove("hidden");
});
els.closeModalBtn.addEventListener("click", () => els.codeModal.classList.add("hidden"));
els.copyCodeBtn.addEventListener("click", () => {
  navigator.clipboard.writeText(els.codeOutput.textContent).then(() => {
    els.copyCodeBtn.textContent = "¡Copiado!";
    setTimeout(() => els.copyCodeBtn.textContent = "Copiar código", 1200);
  });
});
els.downloadJsBtn.addEventListener("click", () => {
  download(`generateDitherTexture-${els.seedInput.value}.js`, buildJsExport(), "text/javascript");
});

// --- init con parámetros del estilo original (navy/blue dithering) ---
els.seedInput.value = 42;
renderMain();
renderVariants();
</script>
</body>
</html>
