{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "devias.ar"
        }
      ],
      "destination": "https://www.devias.ar/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/health",
      "schedule": "0 6 * * *"
    }
  ]
}
