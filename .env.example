# Supabase — copy to .env and fill in (Project Settings → API keys / Data API).
SUPABASE_URL=https://your-project.supabase.co

# Publishable key (sb_publishable_...). Used by /api/contact to insert contacts.
SUPABASE_KEY=sb_publishable_xxx

# Shared secret for the daily keep-alive cron. Set it in the Vercel project env
# and Vercel will send it as `Authorization: Bearer ...` when calling
# /api/health; the route 404s without a match. Any long random string works.
CRON_SECRET=

